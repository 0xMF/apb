function check_console-setup {
  if ! grep  -q  '^FONTFACE="TerminusBold"' /etc/default/console-setup ; then
    lib::ierr "console font was NOT changed to TerminusBold 14x28!!!"
  fi

  if ! grep  -q  '^FONTSIZE="14x28"' /etc/default/console-setup ; then
    lib::ierr "console font was NOT changed to TerminusBold 14x28!!!"
  fi
}

function check_user_login_matrix {
   check_user_history
   if ! grep -q "ssh .*$user@matrix.*" /home/"${user}"/.bash_history; then
    if ! grep -q "^matrix$" /home/"${user}"/.bash_history; then
      lib::ierr "MySeneca user $user has not logged in to matrix from this VM!!!"
    fi
  fi
}


