function check_console-setup {
  if ! grep  -q  '^FONTFACE="TerminusBold"' /etc/default/console-setup ; then
    lib::ierr "console font was NOT changed to TerminusBold 14x28!!!"
  fi

  if ! grep  -q  '^FONTSIZE="14x28"' /etc/default/console-setup ; then
    lib::ierr "console font was NOT changed to TerminusBold 14x28!!!"
  fi
}

