function check_user-alias-matrix {
  if [ ! -s ~"${user}"/.bash_aliases ]; then
    lib::ierr "alias for matrix was NOT found in bash_aliases for MySeneca user $user"
  else
    if ! grep  -q  "alias matrix=[\"']ssh  *${user}@matrix.*" ~"${user}"/.bash_aliases ; then
      lib::ierr "alias for matrix was NOT found in bash_aliases for MySeneca user $user"
    fi
  fi
}

